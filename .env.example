AI_MODEL=@cf/meta/llama-3.1-8b-instruct
SYSTEM_PROMPT=Jsi moje vlastní AI. Odpovídej česky, věcně a užitečně.

# Nika
NIKA_GITHUB_MCP_ENABLED=1

# GitHub MCP
# Safe default: expose only read-only GitHub MCP tools.
GITHUB_READ_ONLY=1
GITHUB_TOOLSETS=context,repos,issues,pull_requests,users
GITHUB_OAUTH_CALLBACK_PORT=8085
GITHUB_MCP_OAUTH=1
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server
